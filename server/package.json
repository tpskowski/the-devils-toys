{
  "name": "@devils-toys/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --external:express --external:cookie-parser --external:bcryptjs --external:zod --external:ws --external:cookie --external:multer --outfile=dist/index.js && esbuild src/tables-server.ts --bundle --platform=node --format=esm --target=node22 --external:node:sqlite --external:express --external:cookie-parser --external:bcryptjs --external:zod --external:ws --external:cookie --external:multer --outfile=dist/tables-server.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:tables": "tsx watch src/tables-server.ts",
    "start:tables": "node dist/tables-server.js",
    "build:items": "tsx src/build-items.ts",
    "build:traits": "tsx src/build-traits.ts"
  },
  "dependencies": {
    "@devils-toys/shared": "0.1.0",
    "@devils-toys/system-cairn": "0.1.0",
    "@devils-toys/system-cwn": "0.1.0",
    "@devils-toys/system-monolith": "0.1.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "multer": "^2.2.0",
    "ws": "^8.18.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.32",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
