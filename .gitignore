# No rules text lives here any more — a game system carries its own, in its own
# repository. What is left in `raw/` is the repository table sets, which belong
# to no system. Anything else under it is source material being worked on for a
# system repository, and is nobody's to publish from here.
#
# `docs/guide/images` is the guide's own screenshots and stays tracked.
/raw/**/*.pdf
/raw/**/*.png
/raw/**/*.html
/raw/*.md
/raw/13th-age-2e/

# Dependencies and build output
node_modules/
**/dist/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Mutable application data: the database, uploads, and logs a table has added
.data/
/.codex-ui-data/
*.log

# Local scratch directories used while developing. `scratch/` is the place for
# throwaway scripts, notes, and working files: nothing in it is ever committed.
/scratch/
.tmp-*
.visual-*

# Environment files: only the documented example is published
.env
.env.*
!.env.example

# Per-developer tool state. The whole directory: it holds local settings, launch
# configurations, and the throwaway git worktrees Claude Code creates — and a
# worktree is a second checkout of this repository, which is the last thing that
# should ever be committed into it.
/.claude/
/dev-local.ps1
/dev-local-linux.sh
/dev-local-macos.sh

# Editor and merge leftovers
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej
*.patch

# Exporter files
/custom-*-repo
custom-*-repo.zip
