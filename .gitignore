# No rules text lives here any more — a game system carries its own, in its own
# repository. What is left in `raw/` is the repository table sets, which belong
# to no system. Anything else under it is source material being worked on for a
# system repository, and is nobody's to publish from here.
#
# `docs/guide/images` is the guide's own screenshots and stays tracked.
/raw/**/*.pdf
/raw/**/*.png
/raw/**/*.html
/raw/*.md
/raw/13th-age-2e/

# Dependencies and build output
node_modules/
**/dist/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Mutable application data, and everything a running server has been given.
#
# This is a licensing boundary as much as a tidiness one. An installed game
# system carries its publisher's rulebook under `<dataDir>/systems/<id>/rules/`;
# a room's Library holds whatever art and handouts a table uploaded; the database
# holds both. None of it is this repository's to publish, and all of it arrives
# as files rather than as a commit anybody reviews.
#
# `.data/` is the default. The rules under it cover a data directory pointed
# somewhere else with DEVILS_TOYS_DATA_DIR — but they cannot cover every name a
# person might choose, so **if you point it somewhere these do not match, add it
# here first**. `server/src/gitignore.test.ts` is what keeps this honest.
.data/
/.data-*/
/data/
# Wherever the data directory ends up: the database holds every installed
# system's tables and every room's own, so its name is worth matching alone.
devils-toys.sqlite*
# An installed system's rulebook, and the two directories an install stages
# through. Deliberately not a bare `rules/`, which is tracked under `fixtures/`.
**/systems/*/rules/
**/systems/*.incoming/
**/systems/*.replaced/
/.codex-ui-data/
*.log

# What the application hands out: a system or a campaign, exported. Both carry
# somebody else's material, and a browser download lands wherever it is pointed.
*.devilsystem.zip
*.devilcampaign.zip
# `npm run systems:export` writes a sibling of this checkout by default; an
# explicit --out could put one inside it.
/devils-toys-*/

# Local scratch directories used while developing. `scratch/` is the place for
# throwaway scripts, notes, and working files: nothing in it is ever committed.
/scratch/
.tmp-*
.visual-*

# Environment files: only the documented example is published
.env
.env.*
!.env.example

# Per-developer tool state. The whole directory: it holds local settings, launch
# configurations, and the throwaway git worktrees Claude Code creates — and a
# worktree is a second checkout of this repository, which is the last thing that
# should ever be committed into it.
/.claude/
/dev-local.ps1
/dev-local-linux.sh
/dev-local-macos.sh

# Editor and merge leftovers
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej
*.patch

# Exporter files
/custom-*-repo
custom-*-repo.zip
