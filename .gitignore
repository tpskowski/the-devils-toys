# Source books: the Markdown is redistributable under CC BY-SA 4.0, the PDFs are
# not ours to publish. Matched at any depth, because a book being worked on gets
# its own folder — `/raw/*.pdf` alone left those PDFs stageable.
#
# Images extracted from those pages are the book's too, so they go the same way.
# This covers `raw/` only: the guide's own screenshots under `docs/guide/images`
# are ours and stay tracked.
/raw/**/*.pdf
/raw/**/*.png

# Dependencies and build output
node_modules/
**/dist/
*.tsbuildinfo
coverage/
playwright-report/
test-results/

# Mutable application data: the database, uploads, and logs a table has added
.data/
*.log

# Local scratch directories used while developing. `scratch/` is the place for
# throwaway scripts, notes, and working files: nothing in it is ever committed.
/scratch/
.tmp-*
.visual-*

# Environment files: only the documented example is published
.env
.env.*
!.env.example

# Per-developer tool state
.claude/settings.local.json
/dev-local.ps1
/dev-local-linux.sh
/dev-local-macos.sh

# Editor and merge leftovers
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej
*.patch

# Exporter files
/custom-*-repo
custom-*-repo.zip