{
  "name": "the-devils-toys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "tables-client",
    "server",
    "shared",
    "systems/*"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace @devils-toys/client",
    "dev:server": "npm run dev --workspace @devils-toys/server",
    "build": "npm run build --workspace @devils-toys/client && npm run build --workspace @devils-toys/tables-client && npm run build --workspace @devils-toys/server",
    "start": "npm run start --workspace @devils-toys/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps chromium",
    "format:check": "prettier --check .",
    "tables:check": "tsx scripts/tables-md-to-json.ts --all --check",
    "smoke": "node scripts/smoke.mjs && node scripts/characters-smoke.mjs && node scripts/management-smoke.mjs && node scripts/capacity-smoke.mjs && node scripts/media-smoke.mjs && node scripts/audio-smoke.mjs && node scripts/npc-smoke.mjs && node scripts/dice-smoke.mjs && node scripts/tables-smoke.mjs && node scripts/tables-editor-smoke.mjs && node scripts/encounter-smoke.mjs && node scripts/group-smoke.mjs && node scripts/room-items-smoke.mjs && node scripts/playlist-smoke.mjs && node scripts/help-smoke.mjs && node scripts/room-config-smoke.mjs",
    "dev:tables-client": "npm run dev --workspace @devils-toys/tables-client",
    "dev:tables-server": "npm run dev:tables --workspace @devils-toys/server",
    "dev:tables": "concurrently -n tables-client,tables-server -c cyan,magenta \"npm:dev:tables-client\" \"npm:dev:tables-server\"",
    "start:tables": "npm run start:tables --workspace @devils-toys/server",
    "build:items": "npm run build:items --workspace @devils-toys/server",
    "build:traits": "npm run build:traits --workspace @devils-toys/server",
    "build:items:merge": "npm run build:items --workspace @devils-toys/server -- --merge",
    "build:traits:merge": "npm run build:traits --workspace @devils-toys/server -- --merge"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
