PORT=4000
DEVILS_TABLES_PORT=4100
# Set only when a reverse proxy serves The Devil's Tables somewhere other than
# this host on DEVILS_TABLES_PORT.
# DEVILS_TABLES_URL=https://tables.example
DEVILS_TOYS_DATA_DIR=.data
DEVILS_TOYS_LOG_LEVEL=info
DEVILS_TOYS_UPLOAD_LIMIT_MB=1024
DEVILS_TOYS_SCENE_IMAGE_LIMIT_MB=60
DEVILS_TOYS_REFERENCE_IMAGE_LIMIT_MB=20
DEVILS_TOYS_AUDIO_LIMIT_MB=50
DEVILS_TOYS_SYSTEM_LIMIT_MB=25
DEVILS_TOYS_CAMPAIGN_LIMIT_MB=2048
DEVILS_TOYS_CAMPAIGN_ENTRY_LIMIT=5000
DEVILS_TOYS_CAMPAIGN_STAGE_TTL_HOURS=24

# The menu of game systems an admin can install from. Defaults to the published
# catalogue, shown below. Point it at your own index to offer a different menu,
# or set it empty for no menu — installing by repository or from a file is
# unaffected either way. Nothing is fetched until an admin opens the panel.
# DEVILS_TOYS_SYSTEM_CATALOG_URL=https://raw.githubusercontent.com/tpskowski/devils-toys-systems/main/index.json
DEVILS_TOYS_SYSTEM_CATALOG_TTL=300

# The only hosts a system may be fetched from. Importing is the one thing that
# makes this server open an outbound connection; widen this only deliberately.
DEVILS_TOYS_SYSTEM_HOSTS=codeload.github.com,raw.githubusercontent.com,api.github.com,objects.githubusercontent.com

# Optional, and only to lift GitHub's unauthenticated rate limit.
# DEVILS_TOYS_GITHUB_TOKEN=
